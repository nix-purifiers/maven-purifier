<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: MIT -->
<!-- Older Maven containers use Plexus registrations rather than the Sisu index. -->
<component-set>
  <components>
    <component>
      <role>org.apache.maven.eventspy.EventSpy</role>
      <role-hint>maven-purifier</role-hint>
      <implementation>io.github.nixpurifiers.maven.CompatibleEventSpy</implementation>
    </component>
    <component>
      <role>org.apache.maven.AbstractMavenLifecycleParticipant</role>
      <role-hint>purifier-locked-replay</role-hint>
      <implementation>io.github.nixpurifiers.maven.LockedReplayParticipant</implementation>
    </component>
    <component>
      <role>org.apache.maven.model.building.ModelProcessor</role>
      <role-hint>default</role-hint>
      <implementation>io.github.nixpurifiers.maven.ProjectedModelProcessor</implementation>
      <requirements>
        <requirement>
          <role>org.apache.maven.model.io.ModelReader</role>
          <field-name>reader</field-name>
        </requirement>
        <requirement>
          <role>org.apache.maven.model.locator.ModelLocator</role>
          <field-name>locator</field-name>
        </requirement>
      </requirements>
    </component>
    <component>
      <role>org.apache.maven.AbstractMavenLifecycleParticipant</role>
      <role-hint>purifier-project-inputs</role-hint>
      <implementation>io.github.nixpurifiers.maven.ProjectedLifecycleParticipant</implementation>
    </component>
  </components>
</component-set>
